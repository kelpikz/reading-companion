{
  "name": "pi-browser-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local browser companion for reading with Pi",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "start": "node dist-server/server/start.js",
    "open": "node scripts/open.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/verify-browser.ts",
    "test:pi": "tsx scripts/verify-pi.ts",
    "test:launcher": "tsx scripts/verify-launcher.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.6",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^27.0.0",
    "marked": "^16.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.19.0",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
